# Kosmos kernel environment (systemd EnvironmentFile format)
# Deploy to /etc/kosmos/kernel.env with mode 0600.
# NEVER commit real credentials here beyond the local dev password.

# MemoryPort backend (ADR-008)
KOSMOS_MEMORY_BACKEND=dozerdb
KOSMOS_DOZERDB_URI=bolt://127.0.0.1:7687
KOSMOS_DOZERDB_USER=neo4j
KOSMOS_DOZERDB_PASSWORD=kosmos-dev-password
KOSMOS_DOZERDB_DATABASE=neo4j

# Qdrant (Stage 1.6 semantic memory · ADR-074 · ops/compose/memory.yml)
# Kosmos-owned host ports; UIA's Qdrant lives on 6371/6372 on the same box.
KOSMOS_QDRANT_URL=http://127.0.0.1:6339

# Zetesis ODR / Ollama shim
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
