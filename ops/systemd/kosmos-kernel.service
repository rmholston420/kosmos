# Kosmos kernel — Colossus systemd unit (ADR-008 DozerDB backed)
#
# Install:
#   sudo cp ops/systemd/kosmos-kernel.service /etc/systemd/system/kosmos-kernel.service
#   sudo cp ops/systemd/kosmos-kernel.env     /etc/kosmos/kernel.env
#   sudo chmod 600 /etc/kosmos/kernel.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kosmos-kernel.service
#
# Logs: journalctl -u kosmos-kernel -f
# Restart: sudo systemctl restart kosmos-kernel

[Unit]
Description=Kosmos kernel (FastAPI + Uvicorn) on Colossus
Documentation=https://github.com/rmholston420/kosmos
After=docker.service network-online.target
Wants=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=rmholston
Group=rmholston
WorkingDirectory=/home/rmholston/dev/kosmos
EnvironmentFile=/etc/kosmos/kernel.env

# Wait for DozerDB bolt port (7687) before starting; retries up to ~60s.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do (echo > /dev/tcp/127.0.0.1/7687) >/dev/null 2>&1 && exit 0; sleep 2; done; echo "DozerDB not reachable on 7687"; exit 1'

ExecStart=/home/rmholston/dev/kosmos/.venv/bin/uvicorn kernel.app:app --host 127.0.0.1 --port 8000

Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/rmholston/dev/kosmos /tmp
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
